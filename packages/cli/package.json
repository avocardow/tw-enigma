{
  "name": "@tw-enigma/cli",
  "version": "1.0.2",
  "type": "module",
  "description": "Command-line interface for tw-enigma CSS optimization",
  "bin": {
    "enigma": "dist/enigma.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --testNamePattern=\"Integration\"",
    "test:e2e": "vitest run --testNamePattern=\"E2E\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"bin/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"bin/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"bin/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\" \"bin/**/*.{ts,js,json}\"",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "clean:coverage": "rimraf coverage",
    "clean:cache": "rimraf node_modules/.cache",
    "clean:all": "rimraf dist coverage node_modules/.cache",
    "start": "node dist/bin/enigma.js"
  },
  "keywords": [
    "cli",
    "css",
    "optimization",
    "tailwind",
    "performance",
    "build-tools"
  ],
  "author": "Rowan Cardow",
  "license": "MIT",
  "homepage": "https://github.com/avocardow/tw-enigma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avocardow/tw-enigma.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/avocardow/tw-enigma/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@tw-enigma/core": "workspace:*",
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "figlet": "^1.8.0",
    "gradient-string": "^3.0.0",
    "inquirer": "^12.5.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "@types/uuid": "^10.0.0",
    "@types/write-file-atomic": "^4.0.3",
    "@types/ws": "^8.5.10"
  }
}
