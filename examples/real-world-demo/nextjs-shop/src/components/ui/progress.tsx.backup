import * as React from &quot;react&quot;
import * as ProgressPrimitive from &quot;@radix-ui/react-progress&quot;

import { cn } from &quot;@/lib/utils&quot;

const Progress = React.forwardRef&lt;
  React.ElementRef<typeof ProgressPrimitive.Root>,
  React.ComponentPropsWithoutRef<typeof ProgressPrimitive.Root>
&gt;(({ className, value, ...props }, ref) =&gt; (
  <progressprimitive.root ref="{ref}" className="{cn(" "relative h-4 w-full overflow-hidden rounded-full bg-secondary", )} {...props}>
    <progressprimitive.indicator className="h-full w-full flex-1 bg-primary transition-all" style="{{" transform: `translateX(-${100 - (value || 0)}%)` }}></progressprimitive.indicator>
    </progressprimitive.root>
      ))
      Progress.displayName = ProgressPrimitive.Root.displayName

    export { Progress }</typeof></typeof>