{
  "name": "tw-enigma-monorepo",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "A post-build optimizer for Tailwind CSS that bundles utility classes into single, obfuscated identifiers.",
  "author": "Rowan Cardow",
  "license": "MIT",
  "homepage": "https://github.com/avocardow/tw-enigma",
  "bugs": {
    "url": "https://github.com/avocardow/tw-enigma/issues"
  },
  "keywords": [
    "tailwind",
    "tailwindcss",
    "css",
    "optimizer",
    "bundle",
    "obfuscate",
    "postcss"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avocardow/tw-enigma.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:all": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:core": "turbo test --filter=@tw-enigma/core",
    "test:cli": "turbo test --filter=@tw-enigma/cli",
    "test:integration": "vitest run tests/integration",
    "test:watch": "turbo test:watch",
    "test:coverage": "turbo test:coverage",
    "test:unit": "turbo test --filter=@tw-enigma/core --filter=@tw-enigma/cli",
    "test:e2e": "vitest run tests/e2e",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "test:ci": "turbo test:ci",
    "test:debug": "vitest run --reporter=verbose",
    "test:failed": "vitest run --reporter=verbose --retry=0",
    "type-check": "turbo type-check",
    "format": "turbo format",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "license:add": "node scripts/add-license-headers.js",
    "license:check": "node scripts/add-license-headers.js --dry-run --verbose",
    "benchmark": "echo 'Benchmark placeholder - will be implemented later'",
    "clean": "turbo clean",
    "clean:cache": "turbo clean:cache && rimraf .turbo",
    "clean:dist": "rimraf packages/*/dist && rimraf dist",
    "clean:coverage": "rimraf coverage && rimraf packages/*/coverage",
    "clean:node-modules": "rimraf node_modules && rimraf packages/*/node_modules",
    "clean:all": "turbo clean:all && pnpm clean:cache && pnpm clean:dist && pnpm clean:coverage",
    "reset": "rm -rf node_modules packages/*/node_modules && pnpm install",
    "update-deps": "pnpm update -r",
    "docs": "typedoc --entryPointStrategy packages ./packages/*/src/index.ts",
    "docs:serve": "pnpm docs && http-server docs --port 8080",
    "check-deps": "madge --circular --extensions ts ./packages",
    "graph": "turbo run build --graph=dependency-graph.png",
    "workspace:info": "pnpm list -r --depth 0",
    "dev:validate": "node scripts/dev-utils.js validate",
    "dev:build": "node scripts/dev-utils.js build",
    "dev:test": "node scripts/dev-utils.js test",
    "dev:lint": "node scripts/dev-utils.js lint",
    "dev:help": "node scripts/dev-utils.js",
    "postinstall": "echo 'Skipping postinstall build due to known core package issues'",
    "coverage": "vitest run --config config/vitest.config.ts --coverage",
    "test:ui": "vitest --config config/vitest.config.ts --ui"
  },
  "dependencies": {
    "@tw-enigma/cli": "workspace:*",
    "@tw-enigma/core": "workspace:*"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.29.4",
    "@eslint/js": "^9.28.0",
    "@tailwindcss/postcss": "^4.1.10",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "@vitest/coverage-v8": "^3.2.3",
    "cheerio": "^1.0.0-rc.12",
    "cli-table3": "^0.6.5",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "http-server": "^14.1.1",
    "madge": "^8.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.3.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.10",
    "tsup": "^8.1.0",
    "turbo": "^2.0.4",
    "typedoc": "^0.28.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.3"
  },
  "packageManager": "pnpm@10.10.0"
}
